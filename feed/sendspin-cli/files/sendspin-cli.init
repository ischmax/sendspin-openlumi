#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/sendspin-cli
CONF=/etc/sendspin-cli.conf

start_service() {
	# state-dir (volume, mute, static delay) is set in $CONF and lives on the overlay
	mkdir -p /etc/sendspin-cli

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	# restart forever, 5 s pause between attempts (e.g. while the network is still coming up)
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
